# Copie este arquivo para .env.local e preencha os valores

# Chave da API do Groq (obrigatório, GRATUITO)
# Obtenha em: https://console.groq.com
GROQ_API_KEY=gsk_...

# URL da API (deixe vazio para usar /api local via Vercel)
VITE_API_URL=

# Client ID do Google OAuth (para integração com Google Agenda)
# Obtenha em: https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=
