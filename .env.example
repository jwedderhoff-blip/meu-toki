# Copie este arquivo para .env.local e preencha os valores

# Chave da API do Groq (obrigatório, GRATUITO)
# Obtenha em: https://console.groq.com
GROQ_API_KEY=gsk_...

# URL da API (deixe vazio para usar /api local via Vercel)
# Se hospedar o backend em outro lugar, coloque a URL aqui
VITE_API_URL=
