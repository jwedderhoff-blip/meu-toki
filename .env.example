# Copie este arquivo para .env.local e preencha os valores

# Chave da API da Anthropic (obrigatório)
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# URL da API (deixe vazio para usar /api local via Vercel)
# Se hospedar o backend em outro lugar, coloque a URL aqui
VITE_API_URL=
